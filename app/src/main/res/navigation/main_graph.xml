<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/splashFragment">
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.escouter.ui.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_autentication"
            app:destination="@id/autentication" />
    </fragment>
    <navigation android:id="@+id/autentication"
        app:startDestination="@id/loginFragment">
        <fragment
            android:id="@+id/cadastroFragment"
            android:name="com.example.escouter.ui.auth.CadastroFragment"
            android:label="CadastroFragment"

            tools:layout="@layout/fragment_cadastro" >
            <action
                android:id="@+id/action_cadastroFragment_to_loginFragment"
                app:destination="@id/loginFragment" />
        </fragment>
        <fragment
            android:id="@+id/loginFragment"
            android:name="com.example.escouter.ui.auth.LoginFragment"
            android:label="LoginFragment"
            tools:layout="@layout/fragment_login" >
            <action
                android:id="@+id/action_loginFragment_to_cadastroFragment"
                app:destination="@id/cadastroFragment" />
        </fragment>
    </navigation>

</navigation>
