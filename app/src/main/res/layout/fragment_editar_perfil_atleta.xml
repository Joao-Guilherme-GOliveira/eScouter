<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.home.EditarPerfilAtletaFragment">

    <ScrollView
        android:id="@+id/scrollEditarPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <!-- TÍTULO -->

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="25dp"
                android:text="Editar Perfil"
                android:textColor="@color/txtPreto"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- FOTO -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="15dp">

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_foto_perfil"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_perfil"
                    android:contentDescription="Foto de perfil" />

                <TextView
                    android:id="@+id/txtAlterarFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="8dp"
                    android:text="Alterar foto"
                    android:textColor="@color/cardPeneira"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </FrameLayout>


            <!-- DADOS DO CADASTRO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="5dp"
                android:text="Dados pessoais"
                android:textColor="@color/txtPreto"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- NOME -->

            <TextView
                android:id="@+id/txtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="25dp"
                android:text="Nome"
                android:textColor="@color/txtPreto"
                android:textSize="14sp" />


            <!-- EMAIL -->

            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="25dp"
                android:text="Email"
                android:textColor="@color/txtCinzaClaro"
                android:textSize="12sp" />


            <!-- LOCALIZAÇÃO -->

            <TextView
                android:id="@+id/txtLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="25dp"
                android:text="Cidade - Estado"
                android:textColor="@color/txtCinzaClaro"
                android:textSize="12sp" />


            <!-- DATA DE NASCIMENTO -->

            <TextView
                android:id="@+id/txtDataNascimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="25dp"
                android:text="Data de nascimento"
                android:textColor="@color/txtCinzaClaro"
                android:textSize="12sp" />


            <!-- ========================= -->
            <!-- INFORMAÇÕES DO ATLETA -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="25dp"
                android:text="Informações do atleta"
                android:textColor="@color/txtPreto"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- POSIÇÃO -->


            <EditText
                android:id="@+id/edtPosicao"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="25dp"
                android:hint="Posição"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textSize="13sp"
                android:textColor="@color/txtPreto"
                android:textColorHint="@color/txtPreto"/>
            <!-- PESO -->
            <EditText
                android:id="@+id/edtPeso"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="25dp"
                android:hint="Peso (kg)"
                android:inputType="numberDecimal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textSize="13sp"
                android:textColor="@color/txtPreto"
                android:textColorHint="@color/txtPreto"/>


            <!-- ALTURA -->

            <EditText
                android:id="@+id/edtAltura"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="25dp"
                android:hint="Altura (m)"
                android:inputType="numberDecimal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textSize="13sp"
                android:textColor="@color/txtPreto"
                android:textColorHint="@color/txtPreto"/>


            <!-- EXPERIÊNCIA -->

            <EditText
                android:id="@+id/edtExperiencia"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="25dp"
                android:hint="Experiência"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textSize="13sp"
                android:textColor="@color/txtPreto"
                android:textColorHint="@color/txtPreto"/>


            <!-- DESCRIÇÃO -->

            <EditText
                android:id="@+id/edtDescricao"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="25dp"
                android:gravity="top"
                android:hint="Fale um pouco sobre você"
                android:inputType="textMultiLine"
                android:padding="15dp"
                android:textSize="13sp"
                android:textColor="@color/txtPreto"
                android:textColorHint="@color/txtPreto"/>


            <!-- ========================= -->
            <!-- MÍDIAS -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="25dp"
                android:text="Mídias"
                android:textColor="@color/txtPreto"
                android:textSize="16sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="25dp"
                android:text="Adicione vídeos ou outras mídias para mostrar seu desempenho."
                android:textColor="@color/txtCinzaClaro"
                android:textSize="11sp" />


            <Button
                android:id="@+id/btnAdicionarMidia"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="25dp"
                android:backgroundTint="@color/cardPeneira"
                android:text="+ Adicionar mídia"
                android:textAllCaps="false"
                android:textColor="@color/txtBranco"
                android:textSize="12sp" />


            <!-- MÍDIAS EXISTENTES -->

            <GridLayout
                android:id="@+id/gridMidias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />


            <!-- ========================= -->
            <!-- BOTÕES -->
            <!-- ========================= -->

            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="25dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="25dp"
                android:backgroundTint="@color/cardPeneira"
                android:text="Salvar alterações"
                android:textAllCaps="false"
                android:textColor="@color/txtBranco"
                android:textSize="13sp" />


            <TextView
                android:id="@+id/txtCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:text="Cancelar"
                android:textColor="@color/cardPeneira"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>