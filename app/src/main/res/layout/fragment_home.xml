<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:id="@+id/cabecalho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/txtPreto"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/desc_name"
                    android:textColor="@color/txtCinza"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- PRÓXIMA PENEIRA -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPeneira"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_cardpeneira"
                android:minHeight="140dp"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtPeneira"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Próxima Peneira"
                    android:textColor="@color/txtBranco"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/txtBranco"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtPeneira" />

                <TextView
                    android:id="@+id/txtData"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/txtBranco"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtTime" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- CRIAR PENEIRA -->
            <Button
                android:id="@+id/btnCriarPeneira"
                style="@style/Botao"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:elevation="0dp"
                android:text="+ Criar Peneira"
                android:textAllCaps="false"
                android:textColor="@color/txtBranco"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnMinhasPeneiras"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_primary"
                android:text="Minhas Peneiras"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="15sp"
                style="@style/Botao" />

            <Button
                android:id="@+id/btnInscreverPeneira"
                style="@style/Botao"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_primary"
                android:text="Inscrever-se na Peneira"
                android:textAllCaps="false"
                android:textColor="@color/txtBranco"
                android:textSize="15sp" />
        <!-- DESTAQUES -->
        <LinearLayout
            android:id="@+id/destaques"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destaques da Semana"
                android:textColor="@color/txtPreto"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSemDestaques"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ainda não há atletas em destaque."
                android:textColor="@color/txtCinza"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- JOGADOR 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardJogador1"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_cardhome"
                android:padding="8dp"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/fotoJogador1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_foto_perfil"
                    android:scaleType="centerCrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/CircularImage" />

                <TextView
                    android:id="@+id/nomeJogador1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/txtPreto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/fotoJogador1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/infoJogador1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/txtCinza"
                    android:textSize="11sp"
                    app:layout_constraintStart_toEndOf="@id/fotoJogador1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nomeJogador1" />

                <!-- "+X na semana" (só aparece se ganhou seguidores nos últimos 7 dias) -->
                <TextView
                    android:id="@+id/chipSemanaJogador1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_estatistica"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/txtBranco"
                    android:textSize="9sp"
                    app:layout_constraintStart_toEndOf="@id/fotoJogador1"
                    app:layout_constraintTop_toBottomOf="@id/infoJogador1" />

                <!-- total de seguidores -->
                <TextView
                    android:id="@+id/chipTotalJogador1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_estatistica"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/txtBranco"
                    android:textSize="9sp"
                    app:layout_constraintStart_toEndOf="@id/chipSemanaJogador1"
                    app:layout_constraintTop_toTopOf="@id/chipSemanaJogador1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- JOGADOR 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardJogador2"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_cardhome"
                android:padding="8dp"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/fotoJogador2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_foto_perfil"
                    android:scaleType="centerCrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/CircularImage" />

                <TextView
                    android:id="@+id/nomeJogador2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/txtPreto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/fotoJogador2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/infoJogador2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/txtCinza"
                    android:textSize="11sp"
                    app:layout_constraintStart_toEndOf="@id/fotoJogador2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nomeJogador2" />

                <TextView
                    android:id="@+id/chipSemanaJogador2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_estatistica"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/txtBranco"
                    android:textSize="9sp"
                    app:layout_constraintStart_toEndOf="@id/fotoJogador2"
                    app:layout_constraintTop_toBottomOf="@id/infoJogador2" />

                <TextView
                    android:id="@+id/chipTotalJogador2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_estatistica"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/txtBranco"
                    android:textSize="9sp"
                    app:layout_constraintStart_toEndOf="@id/chipSemanaJogador2"
                    app:layout_constraintTop_toTopOf="@id/chipSemanaJogador2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- PRÓXIMAS PARTIDAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próximas Partidas"
                android:textColor="@color/txtPreto"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSemProximas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/txtCinza"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- os cards são criados pelo HomeFragment (item_partida) -->
            <LinearLayout
                android:id="@+id/containerProximas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- PARTIDAS RECENTES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partidas Recentes"
                android:textColor="@color/txtPreto"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSemRecentes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/txtCinza"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- os cards são criados pelo HomeFragment (item_partida) -->
            <LinearLayout
                android:id="@+id/containerRecentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/opcoes"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemIconSize="25dp"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
