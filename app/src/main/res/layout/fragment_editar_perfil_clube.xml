<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.home.EditarPerfilClubeFragment">

    <ScrollView
        android:id="@+id/scrollEditarPerfilClube"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editar perfil"
                android:textColor="@color/txtPreto"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Atualize as informações do seu clube"
                android:textColor="@color/txtCinza"
                android:textSize="14sp" />

            <!-- Logo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgLogoClube"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:contentDescription="Logo do clube"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_perfil"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlterarLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Alterar logo"
                android:textAllCaps="false"
                android:textColor="@color/txtBranco"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cardPeneira"
                app:cornerRadius="12dp" />

            <!-- Nome -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNomeClube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Nome do clube"
                android:textColorHint="@color/txtPreto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNomeClube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/txtPreto"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CNPJ -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCnpj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="CNPJ"
                android:textColorHint="@color/txtPreto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCnpj"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="18"
                    android:maxLines="1"
                    android:textColor="@color/txtPreto"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Cidade -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Cidade"
                android:textColorHint="@color/txtPreto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/txtPreto"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Estado -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Estado"
                android:textColorHint="@color/txtPreto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="2"
                    android:maxLines="1"
                    android:textColor="@color/txtPreto"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Descrição -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Descrição do clube"
                android:textColorHint="@color/txtPreto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:textColor="@color/txtPreto"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Telefone -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Telefone"
                android:textColorHint="@color/txtPreto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:textColor="@color/txtPreto"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ========================= -->
            <!-- MÍDIAS -->
            <!-- ========================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Mídias"
                android:textColor="@color/txtPreto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Adicione vídeos ou outras mídias para mostrar seu clube."
                android:textColor="@color/txtCinza"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAdicionarMidia"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/cardPeneira"
                android:text="+  Adicionar mídia"
                android:textAllCaps="false"
                android:textColor="@color/txtBranco"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExcluirSelecionadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/cardPeneira"
                android:text="Excluir selecionadas"
                android:textColor="@color/txtBranco"
                android:textSize="13sp"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/gridMidias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

            <!-- Botão salvar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Salvar alterações"
                android:textAllCaps="false"
                android:textColor="@color/txtBranco"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cardPeneira"
                app:cornerRadius="12dp" />

            <!-- Cancelar -->
            <TextView
                android:id="@+id/txtCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Cancelar"
                android:textColor="@color/cardPeneira"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Sair da conta -->
            <TextView
                android:id="@+id/txtSairConta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Sair da conta"
                android:textColor="@color/cardPeneira"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>