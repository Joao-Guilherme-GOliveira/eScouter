<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/fundo"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="180dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/cd_logo_escouter"
                android:src="@drawable/logo" />

            <!-- Título e progresso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtTituloCadastro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/criar_nova_conta"
                    android:textColor="@color/txtPreto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtProgresso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/passo_1_de_3"
                    android:textColor="@color/cardPeneira"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Barra de progresso -->
            <ProgressBar
                android:id="@+id/progressCadastro"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="10dp"
                android:max="3"
                android:progress="1"
                android:progressTint="@color/cardPeneira" />

            <!-- ================================================= -->
            <!-- PASSO 1 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutPasso1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tipo de Usuário -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="24dp"
                    android:text="@string/tipo_de_usuario" />

                <Spinner
                    android:id="@+id/spinnerTipoUsuario"
                    style="@style/Spinnerstyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:spinnerMode="dropdown" />

                <!-- Nome -->
                <TextView
                    android:id="@+id/lblNome"
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/nome" />

                <EditText
                    android:id="@+id/edtNome"
                    style="@style/FieldInput"
                    android:hint="@string/hint_nome_completo"
                    android:inputType="textPersonName" />

                <!-- Email -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/email" />

                <EditText
                    android:id="@+id/edtEmail"
                    style="@style/FieldInput"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress" />

                <!-- Próximo -->
                <Button
                    android:id="@+id/btnProximo1"
                    style="@style/Button.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:elevation="0dp"
                    android:text="@string/proximo_passo"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- PASSO 2 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutPasso2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Data -->
                <TextView
                    android:id="@+id/lblDataNascimento"
                    style="@style/FieldLabel"
                    android:layout_marginTop="24dp"
                    android:text="@string/data_de_nascimento" />

                <EditText
                    android:id="@+id/edtDataNascimento"
                    style="@style/FieldInput"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="@string/hint_n_00_00_0000"
                    android:inputType="date" />

                <!-- Documento: CPF (atleta) / CNPJ (clube) -->
                <TextView
                    android:id="@+id/lblDocumento"
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/cpf" />

                <EditText
                    android:id="@+id/edtDocumento"
                    style="@style/FieldInput"
                    android:hint="@string/hint_somente_numeros"
                    android:inputType="number"
                    android:maxLength="14" />

                <!-- Posição (somente para Atleta) -->
                <TextView
                    android:id="@+id/lblPosicao"
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/posicao"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spinnerPosicao"
                    style="@style/Spinnerstyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:spinnerMode="dropdown"
                    android:visibility="gone" />

                <!-- Estado -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/estado" />

                <Spinner
                    android:id="@+id/spinnerEstado"
                    style="@style/Spinnerstyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:spinnerMode="dropdown" />

                <!-- Cidade -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/cidade" />

                <AutoCompleteTextView
                    android:id="@+id/edtCidade"
                    style="@style/FieldInput"
                    android:enabled="false"
                    android:hint="@string/hint_selecione_um_estado_primeiro"
                    android:inputType="text"
                    android:completionThreshold="1"
                    android:dropDownHeight="220dp" />

                <!-- Botões -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnVoltar2"
                        style="@style/Botao"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:elevation="0dp"
                        android:text="@string/voltar"
                        android:textAllCaps="false"
                        android:textColor="@color/txtBranco"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnProximo2"
                        style="@style/Botao"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:elevation="0dp"
                        android:text="@string/proximo"
                        android:textAllCaps="false"
                        android:textColor="@color/txtBranco"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- PASSO 3 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutPasso3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Senha -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="24dp"
                    android:text="@string/senha" />

                <EditText
                    android:id="@+id/edtSenha"
                    style="@style/FieldInput"
                    android:hint="@string/hint_senha"
                    android:inputType="textPassword" />

                <!-- Confirmar senha -->
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/confirmar_senha" />

                <EditText
                    android:id="@+id/edtConfirmarSenha"
                    style="@style/FieldInput"
                    android:hint="@string/hint_conf_senha"
                    android:inputType="textPassword" />

                <!-- Botões -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnVoltar3"
                        style="@style/Botao"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:elevation="0dp"
                        android:text="@string/voltar"
                        android:textAllCaps="false"
                        android:textColor="@color/txtBranco"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnCriarConta"
                        style="@style/Botao"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:elevation="0dp"
                        android:text="@string/criar_conta"
                        android:textAllCaps="false"
                        android:textColor="@color/txtBranco"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Login -->
            <TextView
                android:id="@+id/tvJaPossuiConta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/ja_possui_uma_conta_faca_login"
                android:textColor="@color/txtCinzaAzulado"
                android:textSize="16sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</ScrollView>