<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Busca Todos"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/txtPreto"
                android:layout_marginBottom="20dp" />

            <!-- BUSCA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_buscar"
                    android:contentDescription="Buscar" />

                <EditText
                    android:id="@+id/edtBusca"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Buscar atleta ou clube"
                    android:textSize="16sp"
                    android:textColor="@color/txtPreto"
                    android:textColorHint="@color/txtCinzaClaro"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- FILTROS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTodos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Todos"
                    android:textAllCaps="false"
                    android:textColor="@color/txtBranco"
                    android:backgroundTint="@color/cardPeneira" />

                <Button
                    android:id="@+id/btnAtletas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Atletas"
                    android:textAllCaps="false"
                    android:textColor="@color/txtBranco"
                    android:backgroundTint="@color/pontuacoes" />

                <Button
                    android:id="@+id/btnClubes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Clubes"
                    android:textAllCaps="false"
                    android:textColor="@color/txtBranco"
                    android:backgroundTint="@color/pontuacoes" />

            </LinearLayout>

            <!-- CATEGORIAS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorias"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/txtPreto"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- LINHA 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="horizontal">

                    <!-- DEFENSORES -->
                    <LinearLayout
                        android:id="@+id/cardDefensores"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_categoria"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_defensores" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Defensores"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/txtPreto"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <!-- MEIO-CAMPO -->
                    <LinearLayout
                        android:id="@+id/cardMeioCampo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_categoria"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_meio_campista" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meio-campo"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/txtPreto"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- LINHA 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="horizontal">

                    <!-- ATACANTES -->
                    <LinearLayout
                        android:id="@+id/cardAtacantes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_categoria"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_atacantes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Atacantes"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/txtPreto"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <!-- GOLEIROS -->
                    <LinearLayout
                        android:id="@+id/cardGoleiros"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_categoria"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_goleiros" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Goleiros"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/txtPreto"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ATLETAS EM DESTAQUE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atletas em Destaque"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/txtPreto"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/containerAtletas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/opcoes"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemIconSize="25dp"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>