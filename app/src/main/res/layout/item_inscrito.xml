<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_item_peneira">

    <TextView
        android:id="@+id/txtNomeInscrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/txtPreto"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEmailInscrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/txtCinza"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPerfilInscrito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Ver perfil"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/cardPeneira"
        app:cornerRadius="30dp" />

</LinearLayout>