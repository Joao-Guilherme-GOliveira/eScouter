<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ui.home.PerfilFragment">


    <!-- CONTEÚDO DA TELA -->

    <ScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ========================= -->
            <!-- CAPA AZUL -->
            <!-- ========================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <!-- FUNDO AZUL -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@color/cardPeneira" />


                <!-- FOTO DO PERFIL -->

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:layout_gravity="start"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="45dp"
                    android:background="@drawable/bg_foto_perfil"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_perfil"
                    android:contentDescription="Foto de perfil" />

            </FrameLayout>


            <!-- ========================= -->
            <!-- DADOS DO USUÁRIO -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/layoutDadosUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/fundo"
                android:paddingStart="25dp"
                android:paddingTop="0dp"
                android:paddingEnd="25dp"
                android:paddingBottom="12dp">


                <!-- NOME -->

                <TextView
                    android:id="@+id/txtNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome"
                    android:textColor="@color/txtPreto"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- POSIÇÃO E IDADE -->

                <TextView
                    android:id="@+id/txtPosicao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Posição"
                    android:textColor="@color/txtCinzaClaro"
                    android:textSize="14sp" />


                <!-- CIDADE E ESTADO -->

                <TextView
                    android:id="@+id/txtLocalizacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cidade - Estado"
                    android:textColor="@color/txtCinzaClaro"
                    android:textSize="12sp" />


                <!-- DESDE -->

                <TextView
                    android:id="@+id/txtDesde"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Desde"
                    android:textColor="@color/txtCinzaClaro"
                    android:textSize="12sp" />


                <!-- DESCRIÇÃO -->

                <TextView
                    android:id="@+id/txtDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="@color/txtCinzaClaro"
                    android:textSize="14sp" />


                <!-- BOTÃO EDITAR -->

                <Button
                    android:id="@+id/btnEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/cardPeneira"
                    android:text="Editar Perfil"
                    android:textAllCaps="false"
                    android:textColor="@color/txtBranco"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- SEPARADOR -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/txtCinzaClaro" />


            <!-- ========================= -->
            <!-- INFORMAÇÕES -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/layoutInformacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp"
                android:visibility="gone">


                <TextView
                    android:id="@+id/txtTituloInformacoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Informações"
                    android:textColor="@color/txtPreto"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- FUNDO CINZA -->

                <LinearLayout
                    android:id="@+id/cardInformacoes"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginStart="46dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="46dp"
                    android:background="@drawable/bg_card_informacoes"
                    android:orientation="vertical"
                    android:padding="8dp">


                    <!-- PRIMEIRA LINHA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">


                        <!-- IDADE -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_perfil"
                                android:contentDescription="Idade" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Idade"
                                    android:textColor="@color/txtPreto"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/txtIdade"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/txtCinzaClaro"
                                    android:textSize="9sp" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- PESO -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_perfil"
                                android:contentDescription="Peso" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Peso"
                                    android:textColor="@color/txtPreto"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/txtPeso"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/txtCinzaClaro"
                                    android:textSize="9sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>


                    <!-- SEGUNDA LINHA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">


                        <!-- ALTURA -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_perfil"
                                android:contentDescription="Altura" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Altura"
                                    android:textColor="@color/txtPreto"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/txtAltura"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/txtCinzaClaro"
                                    android:textSize="9sp" />

                            </LinearLayout>

                        </LinearLayout>


                        <!-- EXPERIÊNCIA -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_perfil"
                                android:contentDescription="Experiência" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Experiência"
                                    android:textColor="@color/txtPreto"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/txtExperiencia"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/txtCinzaClaro"
                                    android:textSize="9sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <!-- EDITAR INFORMAÇÕES -->

                <TextView
                    android:id="@+id/txtEditarInformacoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="52dp"
                    android:layout_marginTop="5dp"
                    android:text="Editar Informações"
                    android:textColor="@color/cardPeneira"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- SEPARADOR -->

            <View
                android:id="@+id/separadorMidias"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/txtCinzaClaro" />


            <!-- ========================= -->
            <!-- MÍDIAS -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/layoutMidias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="15dp"
                android:visibility="gone">


                <!-- TÍTULO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="44dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/txtTituloMidias"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mídias"
                        android:textColor="@color/txtPreto"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <!-- BOTÃO + -->

                    <TextView
                        android:id="@+id/btnAdicionarMidia"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_midia"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/txtBranco"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- GRID -->

                <GridLayout
                    android:id="@+id/gridMidias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:paddingBottom="5dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================= -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/opcoes"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemIconSize="25dp"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>