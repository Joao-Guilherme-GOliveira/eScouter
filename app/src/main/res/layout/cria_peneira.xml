<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:background="@color/background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/criar_nova_peneira"
            android:textColor="@color/preto"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!--nome do time-->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/nome_do_time"/>
        <EditText
            android:id="@+id/edtNomeTime"
            style="@style/FieldInput"
            android:hint="@string/hint_ex_uniao_fc_sub_19"
            android:inputType="text"/>
        <TextView
            android:id="@+id/InfoNomeTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/preenchido_automaticamente_com_o_nome_do_seu_clube"
            android:textColor="@color/txtCinza"
            android:textSize="11sp"/>

        <!--data da peneira-->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/data_da_peneira"/>

        <EditText
            android:id="@+id/edtDataPeneira"
            style="@style/FieldInput"
            android:hint="@string/hint_selecione_a_data_da_peneira"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"/>

        <!--horario peneira-->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/horario_da_peneira"/>

        <EditText
            android:id="@+id/edtHoraPeneira"
            style="@style/FieldInput"
            android:hint="@string/hint_selecione_o_horario"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            />

        <!--local peneria-->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/local_da_peneira"/>

        <EditText
            android:id="@+id/edtLocalPeneira"
            style="@style/FieldInput"
            android:hint="@string/hint_ex_rua_nelcy_lopes_23_jardim_limoeiro"
            android:inputType="text"/>

        <!--botao salvar-->
        <Button
            android:id="@+id/btnSalvarPeneira"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="0dp"
            android:text="@string/salvar_peneira"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            style="@style/Botao"/>

    </LinearLayout>
</ScrollView>