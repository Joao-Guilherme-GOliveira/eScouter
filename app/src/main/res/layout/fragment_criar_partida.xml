<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:background="@color/background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastrar_partida_2"
            android:textColor="@color/preto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- time da casa -->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/time_da_casa" />
        <EditText
            android:id="@+id/edtTimeCasa"
            style="@style/FieldInput"
            android:hint="@string/hint_nome_do_seu_clube"
            android:inputType="text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/preenchido_automaticamente_com_o_nome_do_seu_clube"
            android:textColor="@color/txtCinza"
            android:textSize="11sp" />

        <!-- time visitante -->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/time_visitante" />
        <EditText
            android:id="@+id/edtTimeVisitante"
            style="@style/FieldInput"
            android:hint="@string/hint_ex_estrela_fc_sub_19"
            android:inputType="textCapWords" />

        <!-- data -->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/data_da_partida" />
        <EditText
            android:id="@+id/edtDataPartida"
            style="@style/FieldInput"
            android:hint="@string/hint_selecione_a_data"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none" />

        <!-- hora -->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/horario_da_partida" />
        <EditText
            android:id="@+id/edtHoraPartida"
            style="@style/FieldInput"
            android:hint="@string/hint_selecione_o_horario"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none" />

        <!-- local -->
        <TextView
            style="@style/FieldLabel"
            android:text="@string/local_da_partida" />

        <Spinner
            android:id="@+id/spinnerLocal"
            style="@style/Spinnerstyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="12dp"
            android:spinnerMode="dropdown" />

        <EditText
            android:id="@+id/edtLocalNovo"
            style="@style/FieldInput"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_ex_ifes_vitoria_vitoria"
            android:inputType="textCapWords"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtLocalInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/escolha_um_local_ja_cadastrado_ou_adicione_um"
            android:textColor="@color/txtCinza"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSalvarPartida"
            style="@style/Botao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="0dp"
            android:text="@string/salvar_partida"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>