<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#33374A</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">#9A9DAD</item>
        <item name="android:textColor">#20222B</item>
    </style>

    <style name="Spinnerstyle">
        <item name="android:popupBackground">@drawable/bg_dropdown</item>

    </style>

    <style name="Botao">
        <item name="backgroundTint">@null</item>
    </style>
</resources>